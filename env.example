# Обязательно: токен от @BotFather
BOT_TOKEN=123456789:AA...

# Необязательно ------------------------------------------------------------
# Redis (плагин Railway). Без него тексты хранятся в памяти и теряются при рестарте.
# REDIS_URL=redis://default:pass@host:6379

WHISPER_TTL=604800
BURN_AFTER_READING=false
NOTIFY_SENDER=true
USE_WEBHOOK=false
